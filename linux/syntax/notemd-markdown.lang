    <context id="color-orange" style-ref="orange"><start>&lt;span style="color:#bc4c00"&gt;</start><end>&lt;/span&gt;</end><include><context sub-pattern="0" where="start" style-ref="marker"/><context sub-pattern="0" where="end" style-ref="marker"/><context ref="markdown:markdown-syntax"/></include></context>
    <context id="color-yellow" style-ref="yellow"><start>&lt;span style="color:#9a6700"&gt;</start><end>&lt;/span&gt;</end><include><context sub-pattern="0" where="start" style-ref="marker"/><context sub-pattern="0" where="end" style-ref="marker"/><context ref="markdown:markdown-syntax"/></include></context>
