<!-- NoteMD extensions to the system Markdown language. -->
<language id="notemd-markdown" name="NoteMD Markdown" version="2.0" _section="Markup">
  <styles>
    <style id="marker" name="marker" map-to="def:comment"/>
    <style id="code" name="code" map-to="def:preformatted-section"/>
    <style id="strike" name="strike" map-to="def:deletion"/>
    <style id="wiki" name="wiki" map-to="def:link-text"/>
    <style id="task" name="task" map-to="def:list-marker"/>
    <style id="table-header" name="table-header" map-to="def:heading"/>
    <style id="red" name="red" map-to="def:constant"/>
    <style id="orange" name="orange" map-to="def:constant"/>
    <style id="yellow" name="yellow" map-to="def:constant"/>
    <style id="green" name="green" map-to="def:constant"/>
    <style id="blue" name="blue" map-to="def:constant"/>
    <style id="purple" name="purple" map-to="def:constant"/>
